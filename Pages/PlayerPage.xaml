<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AplicacionTV.Pages.PlayerPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">
        <toolkit:MediaElement x:Name="Player"
                              ShouldAutoPlay="True"
                              ShouldShowPlaybackControls="True"
                              ShouldKeepScreenOn="True"
                              Aspect="AspectFit"
                              BackgroundColor="Black"
                              MediaFailed="OnMediaFailed"
                              StateChanged="OnStateChanged"
                              HandlerChanged="OnPlayerHandlerChanged" />

        <ActivityIndicator x:Name="Buffering" IsRunning="True" Color="#38BDF8"
                           WidthRequest="64" HeightRequest="64" ZIndex="10"
                           HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />

        <Grid x:Name="InfoBar" Grid.Row="1" ColumnDefinitions="*,Auto" Padding="14,10" BackgroundColor="#0F172A">
            <VerticalStackLayout VerticalOptions="Center">
                <Label x:Name="NameLabel" FontSize="16" FontAttributes="Bold" TextColor="White" />
                <Label x:Name="InfoLabel" FontSize="12" TextColor="#94A3B8" />
            </VerticalStackLayout>
            <Label x:Name="FavLabel" Grid.Column="1" FontSize="30" TextColor="#FACC15" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFavoriteTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Grid>
</ContentPage>
